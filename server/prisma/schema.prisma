generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(uuid())
  trackId   Int
  createdAt DateTime @default(now())
  laps      Lap[]
}

model Lap {
  id             String   @id @default(uuid())
  sessionId      String
  lapNumber      Int
  finalTimeInMS  Int?
  isLapInvalid   Boolean  @default(false)
  telemetryData  Json
  createdAt      DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}